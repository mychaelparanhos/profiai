# ProfIA — Environment Variables Template
# Copie este arquivo para .env.local e preencha com os valores reais
# NUNCA commite o .env.local

# ========================
# Supabase
# ========================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # SECRET — nunca expor ao cliente

# ========================
# NextAuth
# ========================
NEXTAUTH_URL=http://localhost:8080
NEXTAUTH_SECRET=gere-com-openssl-rand-base64-32

# ========================
# Google OAuth / Classroom API
# ========================
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Redirect URIs configurados no Google Cloud Console:
# - http://localhost:8080/api/auth/callback/google (dev)
# - https://profiai.com/api/auth/callback/google (prod)

# ========================
# Anthropic Claude API
# ========================
ANTHROPIC_API_KEY=sk-ant-...

# ========================
# OpenAI (Whisper) — ver PENDENCIAS.md
# ========================
OPENAI_API_KEY=sk-...

# ========================
# Stripe — configurar no Sprint 4 (ver PENDENCIAS.md)
# ========================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ========================
# App
# ========================
NEXT_PUBLIC_APP_URL=http://localhost:8080
NODE_ENV=development
